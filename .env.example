# Server-side only. Never expose this value to the frontend.
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgresql://geosense:geosense@localhost:5432/geosense

# Cesium browser token: restrict its origin in Cesium Ion. It is not a secret.
VITE_CESIUM_ION_TOKEN=

# Optional Jira integration, used only by server-side automation.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Optional OpenTelemetry collector endpoint, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
